# Copy this file to .env.local and fill in your values

# Razorpay Keys - Get from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# This is also used on the frontend (must start with NEXT_PUBLIC_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX

# Razorpay Webhook Secret - Get from Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Admin panel (/admin) — optional; overrides the built-in password
ADMIN_PASSWORD=

# Random secret used to sign login/coupon cookies (32+ random characters).
# Optional on Vercel if BLOB_READ_WRITE_TOKEN is set (used as a fallback).
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Vercel Blob — stores Research Writing uploads. Vercel → Storage → Create Blob store.
# Leave empty to store files in the local ./data folder instead (local testing / self-hosting only).
BLOB_READ_WRITE_TOKEN=

# Hostinger SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@onegrasp.com
SMTP_PASS=YOUR_EMAIL_PASSWORD_HERE
