# Copy this file to .env.local for local development. All values are optional.

# Admin panel (/admin) — overrides the built-in password
ADMIN_PASSWORD=

# Random secret used to sign login/coupon cookies (32+ random characters)
SESSION_SECRET=

# Vercel Blob — stores Research Writing uploads and coupons.
# On Vercel, connecting a Blob store adds BLOB_STORE_ID (or BLOB_READ_WRITE_TOKEN) automatically.
# Leave both empty locally to store files in the ./data folder instead.
BLOB_READ_WRITE_TOKEN=
